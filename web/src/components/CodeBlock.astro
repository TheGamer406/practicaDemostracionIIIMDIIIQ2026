---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  downloadHref: string;
  downloadName: string;
}
const { code, lang = "ts", downloadHref, downloadName } = Astro.props;
---
<div class="panel">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap;">
    <span class="badge">Código</span>
    <a class="download" href={downloadHref} download={downloadName}>⬇ Descargar {downloadName}</a>
  </div>
  <Code code={code} lang={lang} theme="github-dark" />
</div>
