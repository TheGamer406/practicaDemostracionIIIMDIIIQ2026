---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Prueba de Demostración III — Matemática Discreta (FUN-03), Universidad CENFOTEC." } =
  Astro.props;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/calificaciones", label: "1 · Calificaciones" },
  { href: "/inventario", label: "2 · Inventario" },
  { href: "/duplicados", label: "3 · Duplicados" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Matemática Discreta FUN-03</title>
    <script is:inline>
      // Se aplica el tema antes del primer pintado para evitar el parpadeo.
      // El modo claro es el predeterminado; el oscuro solo si se eligió.
      try {
        if (localStorage.getItem("tema") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href="/">
        <span class="brand__mark">∀</span>
        FUN-03 · Matemática Discreta
      </a>
      <nav class="nav">
        {links.map((link) => (
          <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar entre modo claro y oscuro">
        <svg class="icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      Prueba de Demostración III · Universidad CENFOTEC · Los tres algoritmos están
      escritos en Python y se ejecutan paso a paso en esta página.
    </footer>

    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("tema", next);
        } catch (_) {}
      });
    </script>
  </body>
</html>
